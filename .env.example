# Non-secret local development settings. Copy to a file only if a process
# cannot receive environment variables directly. The application does not read
# this file; export the variables or pass them to the process.

# SQLite for local runs and tests. Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./richesse.db

# Directory for generated and approved media. Compose mounts a volume here.
MEDIA_ROOT=./media

# Optional display name. Defaults to richesse-video.
SERVICE_NAME=richesse-video
